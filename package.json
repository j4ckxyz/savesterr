{
  "name": "songsterr-pdf",
  "version": "0.1.0",
  "description": "Interactive CLI that saves Songsterr tabs as clean, printable PDFs \u2014 one file per track.",
  "type": "module",
  "private": true,
  "bin": {
    "songsterr-pdf": "src/cli.ts"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "build": "bun build src/cli.ts --compile --outfile songsterr-pdf"
  },
  "keywords": [
    "songsterr",
    "guitar",
    "tabs",
    "pdf",
    "cli",
    "bun"
  ],
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pdfkit": "^0.17.6"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
